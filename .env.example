# ============================================================================
# Safe Line — environment template
#
# Copy to .env and fill in. .env is git-ignored; this file must stay a template
# with NO real values (checked by scripts/check_env_example.py in CI).
# In deployment, set these in the Render / Vercel dashboards, never in the repo.
# ============================================================================

# --- Access ----------------------------------------------------------------
# Demo gate shown to judges. Share it in the submission description.
# Rotate or delete after the hackathon.
APP_ACCESS_CODE=

# X-API-Key required on every /v1 route except /health.
# A future laboratory client would receive its own key.
API_KEY=

# Strict CORS allow-list, comma-separated. NEVER a wildcard, not even locally —
# a development wildcard inevitably ships.
ALLOWED_ORIGINS=http://localhost:5173

# --- Gemini (primary crop reader) ------------------------------------------
# COMMA-SEPARATED LIST. The adapter rotates to the next credential on a 429 or
# an invalid key, and only then falls through to other providers.
#
# This exists for RESILIENCE: a per-minute rate limit must not stop a 30-form
# run. The sanctioned configuration is:
#   - a primary free key from AI Studio, and optionally
#   - a PAID key on the same account with a low spend cap (~$2), and optionally
#   - independent free keys belonging to DIFFERENT team members' own accounts.
#
# WARNING: creating extra projects or accounts in order to reset a free quota
# violates the provider's terms of service and risks the account being blocked —
# possibly on the night of the final. The hackathon's free-toolbox document
# carries the same warning. Do not do it.
#
# The legitimate ways to stay inside the free tier are the ones this design
# already uses: crop-only payloads, one call per page, an aggressive cache,
# local-first resolution, and failover between DIFFERENT providers.
GEMINI_API_KEYS=

# Primary model for reading crops.
GEMINI_MODEL=gemini-2.5-flash
# Cheaper model for classification and page-group confirmation.
GEMINI_MODEL_LITE=gemini-2.5-flash-lite

# --- Fallback providers ----------------------------------------------------
# First fallback. One key, many providers.
OPENROUTER_API_KEY=
# A ":free" vision model id. Kept in configuration because the free model list
# changes week to week — never hard-code it.
OPENROUTER_VISION_MODEL=

# Last resort. The free toolbox states Groq is weak for Hebrew vision, so use it
# only if a vision model is available in the console that day. Never plan
# accuracy around it.
GROQ_API_KEY=
# Groq is skipped unless a vision model id is set here (or in config/models.yaml).
GROQ_VISION_MODEL=

# --- Engine ----------------------------------------------------------------
# true  -> no provider is contacted at all. Unresolved fields are flagged
#          instead of escalated. A test asserts zero network calls in this mode.
LOCAL_ONLY=false

# Upload caps. 50 MB covers a realistic daily batch (the largest sample PDF is
# ~8 MB / 26 pages) while bounding memory on a 512 MB host.
MAX_UPLOAD_MB=50
MAX_PAGES=200

# Retention window. All page images and extracted values are purged after this.
JOB_TTL_MINUTES=30
# After the purge a job answers "purged" this many minutes, and the sweeper looks every so often.
PURGED_VISIBLE_MINUTES=10
PURGE_SWEEP_MINUTES=5
# SSE: a ": ping" comment this often, and a ceiling on how long one stream may stay open.
SSE_PING_SECONDS=15
SSE_MAX_SECONDS=600

# Rasterization DPI. At 300 the receipt-stamp digits reach ~28 px, above
# Tesseract's ~20 px reliability floor for Hebrew. 200 measured worse on faint
# stamps; 400 tripled memory for no accuracy gain.
RENDER_DPI=300

# Worker coroutines. Matched to Render's 0.1 CPU; raise only on a bigger host.
MAX_CONCURRENCY=2

# A field escalates below this combined score. Re-derived by eval/calibrate.py;
# the tuned value is written to config/models.yaml.
ESCALATION_SCORE_THRESHOLD=0.80
# S9 (T18): false sends crops only, with no redacted context thumbnail (PLAN 6.4).
ESCALATION_SEND_THUMBNAIL=true
# Optional: VISION_CACHE_TTL_MINUTES keeps cached provider answers longer than JOB_TTL_MINUTES.
# Leave it unset on real documents: a cached answer holds patient data.

# --- Intake and image measurement (S0-S2) ----------------------------------
# ZIP entries compressing better than this ratio are refused as a bomb.
ZIP_MAX_RATIO=100
# Pixel budget of one rendered or decoded page, in megapixels (A3 at 300 DPI is ~17).
MAX_RENDER_MEGAPIXELS=30
# A correction is applied only when its measurement crosses its threshold.
SKEW_THRESHOLD_DEG=0.5
SKEW_MAX_DEG=15
BLUR_THRESHOLD=100
ILLUMINATION_CV_THRESHOLD=0.18
NOISE_THRESHOLD=0.05
PERSPECTIVE_THRESHOLD=0.02
# Orientation: how many of the three signals (barcode, OSD, Hebrew word count) must agree.
ROTATION_MIN_VOTES=2
OCR_PROBE_MAX_SIDE=1200
OCR_PROBE_MIN_WORDS=5
OCR_PROBE_MIN_RATIO=1.5
OCR_MIN_WORD_CONFIDENCE=0.30
# Correction parameters.
SHARPEN_SCALE=1.5
SAUVOLA_WINDOW=25
SAUVOLA_K=0.2
THUMB_MAX_SIDE=512
# --- S3 page OCR and barcode sweep (T11) -----------------------------------
OCR_LANGS=heb+eng
TESSERACT_OEM=1
# 3 = fully automatic, mixed blocks. 6 (one block) loses the stickers and the sideways caption.
TESSERACT_PSM=3
OCR_TIMEOUT_SECONDS=120
# Tesseract orientation confidence below which OSD abstains from the S1 vote.
OSD_MIN_CONFIDENCE=2.0
# Width of the y window that puts words on one line, in median word heights.
LINE_HEIGHT_TOLERANCE=1.2
# Neighbourhood of a sticker, caption or label, as a share of the page diagonal.
PROXIMITY_RADIUS=0.06
BARS_RETRY_SCALE=2.0
# Receipt-stamp re-read (T13): reach around the stamp words (share of the diagonal), crops/page.
STAMP_REREAD_REACH=0.10
STAMP_REREAD_MAX=2
# Patient-block re-read: reach around the patient-label words (share of the diagonal), crops/page.
PATIENT_REREAD_REACH=0.06
PATIENT_REREAD_MAX=3
# The number printed under each barcode is re-read on its own band (in bar heights / sizes).
READABLE_LINE_REACH=1.2
READABLE_LINE_MARGIN=0.15
# --- S4 regions (T11) ------------------------------------------------------
# Similarity (0-100) at which OCR text counts as a caption, stamp phrase or label.
CENTRAL_CAPTION_FUZZ=80
UPRIGHT_CAPTION_FUZZ=85
RECEIPT_STAMP_FUZZ=80
LABEL_FUZZ=85
# How far a label's value extends past the label, in page widths.
LABEL_VALUE_EXPAND=0.18
LETTERHEAD_FRACTION=0.22
LEARNED_REGION_SCORE=0.40

# --- S6 central number and receipt date (T13) ----------------------------
# A handwritten receipt date must lie this share of the diagonal from a central sticker.
RECEIPT_DATE_RADIUS=0.04

# --- TrOCR handwritten-digit reader (T13) --------------------------------
# Files inside MODELS_DIR, produced by `python -m tools.export_trocr`.
TROCR_VISION_FILE=trocr_small_encoder_int8.onnx
TROCR_TEXT_FILE=trocr_small_decoder_int8.onnx
TROCR_VOCAB_FILE=trocr_small_vocab.json
TROCR_MAX_LENGTH=12
TROCR_CANDIDATES=5
# Larger model files are refused (512 MB host budget).
TROCR_MAX_MODEL_MB=80

# --- S4 region detector (T16) ----------------------------------------------
# rule_based (default, the baseline) | yolo_onnx (experiment; ADR-016 decides). A missing
# model file falls back to rule_based.
REGION_DETECTOR=rule_based
YOLO_MODEL_FILE=yolov8n_regions_int8.onnx
YOLO_CONF=0.35
YOLO_IOU=0.45
YOLO_IMGSZ=1024
# Larger model files are refused.
YOLO_MAX_MODEL_MB=15
# Classes where YOLO replaces the rule-based regions (comma-separated region kinds).
YOLO_KINDS=central_sticker,receipt_stamp,patient_box,commitment_label

# --- Paths -----------------------------------------------------------------
# Tesseract binary. Docker: /usr/bin/tesseract.
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=/usr/bin/tesseract

# ONNX weights (TrOCR-small, YOLOv8n). Git-ignored; see models/README.md.
MODELS_DIR=./models

# Job directories and the learning database. Docker: /tmp/safeline, so nothing
# survives a restart.
DATA_DIR=./.tmp

# --- Observability ---------------------------------------------------------
# DEBUG never enables value logging: redaction is a structlog processor, not a
# log level.
LOG_LEVEL=INFO

# --- Frontend (frontend/.env.local) ----------------------------------------
# VITE_API_BASE=http://localhost:8000
# VITE_USE_MOCK=1          # 1 = render from fixtures/sample_job.json
